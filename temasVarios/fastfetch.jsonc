{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {"1": "{{colors.primary.default.hex}}", "2": "{{colors.secondary.default.hex}}"},
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰁕 ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.primary.default.hex}}",
      "separator": "{{colors.tertiary.default.hex}}"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "{{colors.primary.default.hex}}",
        "at": "{{colors.outline.default.hex}}",
        "host": "{{colors.secondary.default.hex}}"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "{{colors.surface_variant.default.hex}}"
    },
    "break",
    {
      "type": "os",
      "key": "╭─  OS",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "host",
      "key": "├─ 󰌢 PC",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "kernel",
      "key": "├─  Kernel",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    {
      "type": "uptime",
      "key": "╰─ 󰅐 Uptime",
      "keyColor": "{{colors.primary.default.hex}}"
    },
    "break",
    {
      "type": "packages",
      "key": "╭─ 󰏖 Packages",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "shell",
      "key": "├─  Shell",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "wm",
      "key": "├─  WM",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "terminal",
      "key": "╰─  Terminal",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─  CPU",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "gpu",
      "key": "├─ 󰢮 GPU",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "memory",
      "key": "╰─  Memory",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    "break"
  ]
}
