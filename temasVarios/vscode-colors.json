{
    "workbench.colorCustomizations": {
        "editor.background": "#00000000",
        "sideBar.background": "#00000000",
        "activityBar.background": "#00000000",
        "panel.background": "#00000000",
        "terminal.background": "#00000000",
        "titleBar.activeBackground": "#00000000",
        "titleBar.inactiveBackground": "#00000000",
        "window.activeBorder": "{{colors.primary.default.hex}}",
        "editorGroupHeader.tabsBackground": "#00000000",
        "tab.activeBackground": "{{colors.surface_container_low.default.hex}}60",
        "tab.inactiveBackground": "#00000000"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["keyword", "storage", "variable.language"],
                "settings": {
                    "foreground": "{{colors.primary.default.hex}}",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": ["entity.name.function", "support.function"],
                "settings": {
                    "foreground": "{{colors.secondary.default.hex}}",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": ["string", "markup.inline.raw"],
                "settings": {
                    "foreground": "{{colors.tertiary.default.hex}}",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": ["variable", "support.variable"],
                "settings": {
                    "foreground": "{{colors.on_surface.default.hex}}",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": ["comment", "punctuation.definition.comment"],
                "settings": {
                    "foreground": "{{colors.outline.default.hex}}"
                }
            }
        ]
    }
}
