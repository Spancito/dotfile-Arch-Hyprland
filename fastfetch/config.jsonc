{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {"1": "#fface8", "2": "#f5b2e1"},
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰁕 ",
    "color": {
      "keys": "#fface8",
      "title": "#fface8",
      "separator": "#9cd84c"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#fface8",
        "at": "#a08b97",
        "host": "#f5b2e1"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "#53424d"
    },
    "break",
    {
      "type": "os",
      "key": "╭─  OS",
      "keyColor": "#fface8"
    },
    {
      "type": "host",
      "key": "├─ 󰌢 PC",
      "keyColor": "#fface8"
    },
    {
      "type": "kernel",
      "key": "├─  Kernel",
      "keyColor": "#fface8"
    },
    {
      "type": "uptime",
      "key": "╰─ 󰅐 Uptime",
      "keyColor": "#fface8"
    },
    "break",
    {
      "type": "packages",
      "key": "╭─ 󰏖 Packages",
      "keyColor": "#f5b2e1"
    },
    {
      "type": "shell",
      "key": "├─  Shell",
      "keyColor": "#f5b2e1"
    },
    {
      "type": "wm",
      "key": "├─  WM",
      "keyColor": "#f5b2e1"
    },
    {
      "type": "terminal",
      "key": "╰─  Terminal",
      "keyColor": "#f5b2e1"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─  CPU",
      "keyColor": "#9cd84c"
    },
    {
      "type": "gpu",
      "key": "├─ 󰢮 GPU",
      "keyColor": "#9cd84c"
    },
    {
      "type": "memory",
      "key": "╰─  Memory",
      "keyColor": "#9cd84c"
    },
    "break"
  ]
}
