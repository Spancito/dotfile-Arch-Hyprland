{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch"
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "Arch Linux {6}"
    },
    "host",
    {
      "type": "kernel",
      "format": "Linux 6.13.0-arch1-1"
    },
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
//    "colors"
  ]
}
