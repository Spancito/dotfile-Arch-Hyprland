{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {"1": "#bac9d2", "2": "#c2c7cb"},
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰁕 ",
    "color": {
      "keys": "#bac9d2",
      "title": "#bac9d2",
      "separator": "#ddc1ac"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#bac9d2",
        "at": "#8d9194",
        "host": "#c2c7cb"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "#43474a"
    },
    "break",
    {
      "type": "os",
      "key": "╭─  OS",
      "keyColor": "#bac9d2"
    },
    {
      "type": "host",
      "key": "├─ 󰌢 PC",
      "keyColor": "#bac9d2"
    },
    {
      "type": "kernel",
      "key": "├─  Kernel",
      "keyColor": "#bac9d2"
    },
    {
      "type": "uptime",
      "key": "╰─ 󰅐 Uptime",
      "keyColor": "#bac9d2"
    },
    "break",
    {
      "type": "packages",
      "key": "╭─ 󰏖 Packages",
      "keyColor": "#c2c7cb"
    },
    {
      "type": "shell",
      "key": "├─  Shell",
      "keyColor": "#c2c7cb"
    },
    {
      "type": "wm",
      "key": "├─  WM",
      "keyColor": "#c2c7cb"
    },
    {
      "type": "terminal",
      "key": "╰─  Terminal",
      "keyColor": "#c2c7cb"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─  CPU",
      "keyColor": "#ddc1ac"
    },
    {
      "type": "gpu",
      "key": "├─ 󰢮 GPU",
      "keyColor": "#ddc1ac"
    },
    {
      "type": "memory",
      "key": "╰─  Memory",
      "keyColor": "#ddc1ac"
    },
    "break"
  ]
}
