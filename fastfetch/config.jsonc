{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {"1": "#efb0ff", "2": "#e1b9e9"},
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰁕 ",
    "color": {
      "keys": "#efb0ff",
      "title": "#efb0ff",
      "separator": "#c5ce52"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#efb0ff",
        "at": "#9a8c9b",
        "host": "#e1b9e9"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "#4e4350"
    },
    "break",
    {
      "type": "os",
      "key": "╭─  OS",
      "keyColor": "#efb0ff"
    },
    {
      "type": "host",
      "key": "├─ 󰌢 PC",
      "keyColor": "#efb0ff"
    },
    {
      "type": "kernel",
      "key": "├─  Kernel",
      "keyColor": "#efb0ff"
    },
    {
      "type": "uptime",
      "key": "╰─ 󰅐 Uptime",
      "keyColor": "#efb0ff"
    },
    "break",
    {
      "type": "packages",
      "key": "╭─ 󰏖 Packages",
      "keyColor": "#e1b9e9"
    },
    {
      "type": "shell",
      "key": "├─  Shell",
      "keyColor": "#e1b9e9"
    },
    {
      "type": "wm",
      "key": "├─  WM",
      "keyColor": "#e1b9e9"
    },
    {
      "type": "terminal",
      "key": "╰─  Terminal",
      "keyColor": "#e1b9e9"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─  CPU",
      "keyColor": "#c5ce52"
    },
    {
      "type": "gpu",
      "key": "├─ 󰢮 GPU",
      "keyColor": "#c5ce52"
    },
    {
      "type": "memory",
      "key": "╰─  Memory",
      "keyColor": "#c5ce52"
    },
    "break"
  ]
}
