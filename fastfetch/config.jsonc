{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {"1": "#c4c6cd", "2": "#c7c6c9"},
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰁕 ",
    "color": {
      "keys": "#c4c6cd",
      "title": "#c4c6cd",
      "separator": "#d3c4bb"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#c4c6cd",
        "at": "#8f9095",
        "host": "#c7c6c9"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "#45474b"
    },
    "break",
    {
      "type": "os",
      "key": "╭─  OS",
      "keyColor": "#c4c6cd"
    },
    {
      "type": "host",
      "key": "├─ 󰌢 PC",
      "keyColor": "#c4c6cd"
    },
    {
      "type": "kernel",
      "key": "├─  Kernel",
      "keyColor": "#c4c6cd"
    },
    {
      "type": "uptime",
      "key": "╰─ 󰅐 Uptime",
      "keyColor": "#c4c6cd"
    },
    "break",
    {
      "type": "packages",
      "key": "╭─ 󰏖 Packages",
      "keyColor": "#c7c6c9"
    },
    {
      "type": "shell",
      "key": "├─  Shell",
      "keyColor": "#c7c6c9"
    },
    {
      "type": "wm",
      "key": "├─  WM",
      "keyColor": "#c7c6c9"
    },
    {
      "type": "terminal",
      "key": "╰─  Terminal",
      "keyColor": "#c7c6c9"
    },
    "break",
    {
      "type": "cpu",
      "key": "╭─  CPU",
      "keyColor": "#d3c4bb"
    },
    {
      "type": "gpu",
      "key": "├─ 󰢮 GPU",
      "keyColor": "#d3c4bb"
    },
    {
      "type": "memory",
      "key": "╰─  Memory",
      "keyColor": "#d3c4bb"
    },
    "break"
  ]
}
