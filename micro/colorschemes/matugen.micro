color-link default "#e3e2e5,default"
color-link comment "#8e9198"
color-link identifier "bold #b2c8ed"
color-link constant "bold #bfc7d7"
color-link statement "bold #e4c286"
color-link symbol "bold #b2c8ed"
color-link preproc "bold #bfc7d7"
color-link type "bold #e4c286"
color-link special "bold #b2c8ed"
color-link underlined "underline #bfc7d7"
color-link error "bold #ffb4ab"
color-link todo "bold #1b314f,#b2c8ed"
color-link hlsearch "#29313e,#bfc7d7"
color-link statusline "#e3e2e5,default"
color-link tabbar "#e3e2e5,default"
color-link indent-char "#44474e"
color-link line-number "#8e9198,default"
color-link current-line-number "bold #b2c8ed,default"
color-link diff-added "bold #b2c8ed"
color-link diff-modified "bold #bfc7d7"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e4c286"
color-link cursor-line "#44474e"
color-link color-column "#44474e"
