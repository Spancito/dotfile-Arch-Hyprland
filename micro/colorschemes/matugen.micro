color-link default "#ede1d2,default"
color-link comment "#9d8f7a"
color-link identifier "bold #fdbc30"
color-link constant "bold #e5c184"
color-link statement "bold #9ccbff"
color-link symbol "bold #fdbc30"
color-link preproc "bold #e5c184"
color-link type "bold #9ccbff"
color-link special "bold #fdbc30"
color-link underlined "underline #e5c184"
color-link error "bold #ffb4ab"
color-link todo "bold #412d00,#fdbc30"
color-link hlsearch "#412d00,#e5c184"
color-link statusline "#ede1d2,default"
color-link tabbar "#ede1d2,default"
color-link indent-char "#504534"
color-link line-number "#9d8f7a,default"
color-link current-line-number "bold #fdbc30,default"
color-link diff-added "bold #fdbc30"
color-link diff-modified "bold #e5c184"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#9ccbff"
color-link cursor-line "#504534"
color-link color-column "#504534"
