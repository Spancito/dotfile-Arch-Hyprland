color-link default "#eedfe4,default"
color-link comment "#9f8c94"
color-link identifier "bold #ffaed9"
color-link constant "bold #ebb8d1"
color-link statement "bold #9ad77c"
color-link symbol "bold #ffaed9"
color-link preproc "bold #ebb8d1"
color-link type "bold #9ad77c"
color-link special "bold #ffaed9"
color-link underlined "underline #ebb8d1"
color-link error "bold #ffb4ab"
color-link todo "bold #5c0f43,#ffaed9"
color-link hlsearch "#482539,#ebb8d1"
color-link statusline "#eedfe4,default"
color-link tabbar "#eedfe4,default"
color-link indent-char "#52424a"
color-link line-number "#9f8c94,default"
color-link current-line-number "bold #ffaed9,default"
color-link diff-added "bold #ffaed9"
color-link diff-modified "bold #ebb8d1"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#9ad77c"
color-link cursor-line "#52424a"
color-link color-column "#52424a"
