color-link default "#efdee7,default"
color-link comment "#a08b97"
color-link identifier "bold #fface8"
color-link constant "bold #f5b2e1"
color-link statement "bold #9cd84c"
color-link symbol "bold #fface8"
color-link preproc "bold #f5b2e1"
color-link type "bold #9cd84c"
color-link special "bold #fface8"
color-link underlined "underline #f5b2e1"
color-link error "bold #ffb4ab"
color-link todo "bold #5e0053,#fface8"
color-link hlsearch "#4e1e45,#f5b2e1"
color-link statusline "#efdee7,default"
color-link tabbar "#efdee7,default"
color-link indent-char "#53424d"
color-link line-number "#a08b97,default"
color-link current-line-number "bold #fface8,default"
color-link diff-added "bold #fface8"
color-link diff-modified "bold #f5b2e1"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#9cd84c"
color-link cursor-line "#53424d"
color-link color-column "#53424d"
