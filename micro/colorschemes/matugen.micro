color-link default "#e4e2e4,default"
color-link comment "#909097"
color-link identifier "bold #bec6e0"
color-link constant "bold #c4c6d1"
color-link statement "bold #dcc39b"
color-link symbol "bold #bec6e0"
color-link preproc "bold #c4c6d1"
color-link type "bold #dcc39b"
color-link special "bold #bec6e0"
color-link underlined "underline #c4c6d1"
color-link error "bold #ffb4ab"
color-link todo "bold #283045,#bec6e0"
color-link hlsearch "#2d3039,#c4c6d1"
color-link statusline "#e4e2e4,default"
color-link tabbar "#e4e2e4,default"
color-link indent-char "#45464d"
color-link line-number "#909097,default"
color-link current-line-number "bold #bec6e0,default"
color-link diff-added "bold #bec6e0"
color-link diff-modified "bold #c4c6d1"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#dcc39b"
color-link cursor-line "#45464d"
color-link color-column "#45464d"
