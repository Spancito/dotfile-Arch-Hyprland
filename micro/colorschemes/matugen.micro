color-link default "#e4e2e2,default"
color-link comment "#8d9194"
color-link identifier "bold #bac9d2"
color-link constant "bold #c2c7cb"
color-link statement "bold #ddc1ac"
color-link symbol "bold #bac9d2"
color-link preproc "bold #c2c7cb"
color-link type "bold #ddc1ac"
color-link special "bold #bac9d2"
color-link underlined "underline #c2c7cb"
color-link error "bold #ffb4ab"
color-link todo "bold #243239,#bac9d2"
color-link hlsearch "#2c3134,#c2c7cb"
color-link statusline "#e4e2e2,default"
color-link tabbar "#e4e2e2,default"
color-link indent-char "#43474a"
color-link line-number "#8d9194,default"
color-link current-line-number "bold #bac9d2,default"
color-link diff-added "bold #bac9d2"
color-link diff-modified "bold #c2c7cb"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#ddc1ac"
color-link cursor-line "#43474a"
color-link color-column "#43474a"
