color-link default "#ebdfe9,default"
color-link comment "#9a8c9b"
color-link identifier "bold #efb0ff"
color-link constant "bold #e1b9e9"
color-link statement "bold #c5ce52"
color-link symbol "bold #efb0ff"
color-link preproc "bold #e1b9e9"
color-link type "bold #c5ce52"
color-link special "bold #efb0ff"
color-link underlined "underline #e1b9e9"
color-link error "bold #ffb4ab"
color-link todo "bold #53006e,#efb0ff"
color-link hlsearch "#42254b,#e1b9e9"
color-link statusline "#ebdfe9,default"
color-link tabbar "#ebdfe9,default"
color-link indent-char "#4e4350"
color-link line-number "#9a8c9b,default"
color-link current-line-number "bold #efb0ff,default"
color-link diff-added "bold #efb0ff"
color-link diff-modified "bold #e1b9e9"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#c5ce52"
color-link cursor-line "#4e4350"
color-link color-column "#4e4350"
