color-link default "#e5e1e9,default"
color-link comment "#928f9a"
color-link identifier "bold #c3c0ff"
color-link constant "bold #c7c4dd"
color-link statement "bold #eab9d1"
color-link symbol "bold #c3c0ff"
color-link preproc "bold #c7c4dd"
color-link type "bold #eab9d1"
color-link special "bold #c3c0ff"
color-link underlined "underline #c7c4dd"
color-link error "bold #ffb4ab"
color-link todo "bold #2b2a60,#c3c0ff"
color-link hlsearch "#2f2e42,#c7c4dd"
color-link statusline "#e5e1e9,default"
color-link tabbar "#e5e1e9,default"
color-link indent-char "#47464f"
color-link line-number "#928f9a,default"
color-link current-line-number "bold #c3c0ff,default"
color-link diff-added "bold #c3c0ff"
color-link diff-modified "bold #c7c4dd"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#eab9d1"
color-link cursor-line "#47464f"
color-link color-column "#47464f"
