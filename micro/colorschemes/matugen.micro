color-link default "#e5e2e2,default"
color-link comment "#8f9095"
color-link identifier "bold #c4c6cd"
color-link constant "bold #c7c6c9"
color-link statement "bold #d3c4bb"
color-link symbol "bold #c4c6cd"
color-link preproc "bold #c7c6c9"
color-link type "bold #d3c4bb"
color-link special "bold #c4c6cd"
color-link underlined "underline #c7c6c9"
color-link error "bold #ffb4ab"
color-link todo "bold #2e3136,#c4c6cd"
color-link hlsearch "#303032,#c7c6c9"
color-link statusline "#e5e2e2,default"
color-link tabbar "#e5e2e2,default"
color-link indent-char "#45474b"
color-link line-number "#8f9095,default"
color-link current-line-number "bold #c4c6cd,default"
color-link diff-added "bold #c4c6cd"
color-link diff-modified "bold #c7c6c9"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#d3c4bb"
color-link cursor-line "#45474b"
color-link color-column "#45474b"
