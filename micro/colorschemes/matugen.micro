color-link default "#eae0e1,default"
color-link comment "#9c8d90"
color-link identifier "bold #f0b7c8"
color-link constant "bold #dcbfc6"
color-link statement "bold #afcfaa"
color-link symbol "bold #f0b7c8"
color-link preproc "bold #dcbfc6"
color-link type "bold #afcfaa"
color-link special "bold #f0b7c8"
color-link underlined "underline #dcbfc6"
color-link error "bold #ffb4ab"
color-link todo "bold #4a2532,#f0b7c8"
color-link hlsearch "#3e2b31,#dcbfc6"
color-link statusline "#eae0e1,default"
color-link tabbar "#eae0e1,default"
color-link indent-char "#504447"
color-link line-number "#9c8d90,default"
color-link current-line-number "bold #f0b7c8,default"
color-link diff-added "bold #f0b7c8"
color-link diff-modified "bold #dcbfc6"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#afcfaa"
color-link cursor-line "#504447"
color-link color-column "#504447"
