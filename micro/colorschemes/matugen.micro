color-link default "#f1dfdb,default"
color-link comment "#a08c88"
color-link identifier "bold #ffb4a3"
color-link constant "bold #e7bdb4"
color-link statement "bold #dbc58c"
color-link symbol "bold #ffb4a3"
color-link preproc "bold #e7bdb4"
color-link type "bold #dbc58c"
color-link special "bold #ffb4a3"
color-link underlined "underline #e7bdb4"
color-link error "bold #ffb4ab"
color-link todo "bold #561f12,#ffb4a3"
color-link hlsearch "#442a23,#e7bdb4"
color-link statusline "#f1dfdb,default"
color-link tabbar "#f1dfdb,default"
color-link indent-char "#534340"
color-link line-number "#a08c88,default"
color-link current-line-number "bold #ffb4a3,default"
color-link diff-added "bold #ffb4a3"
color-link diff-modified "bold #e7bdb4"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#dbc58c"
color-link cursor-line "#534340"
color-link color-column "#534340"
