color-link default "#e4e2e1,default"
color-link comment "#8c9291"
color-link identifier "bold #bacac9"
color-link constant "bold #c2c7c7"
color-link statement "bold #ddc1b6"
color-link symbol "bold #bacac9"
color-link preproc "bold #c2c7c7"
color-link type "bold #ddc1b6"
color-link special "bold #bacac9"
color-link underlined "underline #c2c7c7"
color-link error "bold #ffb4ab"
color-link todo "bold #253333,#bacac9"
color-link hlsearch "#2c3131,#c2c7c7"
color-link statusline "#e4e2e1,default"
color-link tabbar "#e4e2e1,default"
color-link indent-char "#424848"
color-link line-number "#8c9291,default"
color-link current-line-number "bold #bacac9,default"
color-link diff-added "bold #bacac9"
color-link diff-modified "bold #c2c7c7"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#ddc1b6"
color-link cursor-line "#424848"
color-link color-column "#424848"
