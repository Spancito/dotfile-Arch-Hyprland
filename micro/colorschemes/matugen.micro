color-link default "#fddbd4,default"
color-link comment "#ad8880"
color-link identifier "bold #ffb4a3"
color-link constant "bold #ffb4a3"
color-link statement "bold #aec6ff"
color-link symbol "bold #ffb4a3"
color-link preproc "bold #ffb4a3"
color-link type "bold #aec6ff"
color-link special "bold #ffb4a3"
color-link underlined "underline #ffb4a3"
color-link error "bold #ffb4ab"
color-link todo "bold #630f00,#ffb4a3"
color-link hlsearch "#630f00,#ffb4a3"
color-link statusline "#fddbd4,default"
color-link tabbar "#fddbd4,default"
color-link indent-char "#5d4039"
color-link line-number "#ad8880,default"
color-link current-line-number "bold #ffb4a3,default"
color-link diff-added "bold #ffb4a3"
color-link diff-modified "bold #ffb4a3"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#aec6ff"
color-link cursor-line "#5d4039"
color-link color-column "#5d4039"
