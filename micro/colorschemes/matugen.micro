color-link default "#e4e2e3,default"
color-link comment "#8e9196"
color-link identifier "bold #bbc8d7"
color-link constant "bold #c3c7cd"
color-link statement "bold #e1c0ac"
color-link symbol "bold #bbc8d7"
color-link preproc "bold #c3c7cd"
color-link type "bold #e1c0ac"
color-link special "bold #bbc8d7"
color-link underlined "underline #c3c7cd"
color-link error "bold #ffb4ab"
color-link todo "bold #26323d,#bbc8d7"
color-link hlsearch "#2c3136,#c3c7cd"
color-link statusline "#e4e2e3,default"
color-link tabbar "#e4e2e3,default"
color-link indent-char "#44474b"
color-link line-number "#8e9196,default"
color-link current-line-number "bold #bbc8d7,default"
color-link diff-added "bold #bbc8d7"
color-link diff-modified "bold #c3c7cd"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e1c0ac"
color-link cursor-line "#44474b"
color-link color-column "#44474b"
