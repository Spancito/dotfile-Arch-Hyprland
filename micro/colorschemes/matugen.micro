color-link default "#eee0db,default"
color-link comment "#a18c85"
color-link identifier "bold #ffb59a"
color-link constant "bold #eabcac"
color-link statement "bold #81d5cb"
color-link symbol "bold #ffb59a"
color-link preproc "bold #eabcac"
color-link type "bold #81d5cb"
color-link special "bold #ffb59a"
color-link underlined "underline #eabcac"
color-link error "bold #ffb4ab"
color-link todo "bold #552009,#ffb59a"
color-link hlsearch "#46291e,#eabcac"
color-link statusline "#eee0db,default"
color-link tabbar "#eee0db,default"
color-link indent-char "#53433e"
color-link line-number "#a18c85,default"
color-link current-line-number "bold #ffb59a,default"
color-link diff-added "bold #ffb59a"
color-link diff-modified "bold #eabcac"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#81d5cb"
color-link cursor-line "#53433e"
color-link color-column "#53433e"
