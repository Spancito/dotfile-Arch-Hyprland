color-link default "#e3e2e4,default"
color-link comment "#8d9197"
color-link identifier "bold #adcae3"
color-link constant "bold #bdc8d3"
color-link statement "bold #edbd97"
color-link symbol "bold #adcae3"
color-link preproc "bold #bdc8d3"
color-link type "bold #edbd97"
color-link special "bold #adcae3"
color-link underlined "underline #bdc8d3"
color-link error "bold #ffb4ab"
color-link todo "bold #153347,#adcae3"
color-link hlsearch "#27323a,#bdc8d3"
color-link statusline "#e3e2e4,default"
color-link tabbar "#e3e2e4,default"
color-link indent-char "#42474c"
color-link line-number "#8d9197,default"
color-link current-line-number "bold #adcae3,default"
color-link diff-added "bold #adcae3"
color-link diff-modified "bold #bdc8d3"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#edbd97"
color-link cursor-line "#42474c"
color-link color-column "#42474c"
