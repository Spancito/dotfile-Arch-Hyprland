color-link default "#f9dcd8,default"
color-link comment "#ab8985"
color-link identifier "bold #ffb4ab"
color-link constant "bold #ffb4ab"
color-link statement "bold #85cfff"
color-link symbol "bold #ffb4ab"
color-link preproc "bold #ffb4ab"
color-link type "bold #85cfff"
color-link special "bold #ffb4ab"
color-link underlined "underline #ffb4ab"
color-link error "bold #ffb4ab"
color-link todo "bold #690005,#ffb4ab"
color-link hlsearch "#61120f,#ffb4ab"
color-link statusline "#f9dcd8,default"
color-link tabbar "#f9dcd8,default"
color-link indent-char "#5b403d"
color-link line-number "#ab8985,default"
color-link current-line-number "bold #ffb4ab,default"
color-link diff-added "bold #ffb4ab"
color-link diff-modified "bold #ffb4ab"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#85cfff"
color-link cursor-line "#5b403d"
color-link color-column "#5b403d"
