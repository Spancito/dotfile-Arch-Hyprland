color-link default "#dfe4df,default"
color-link comment "#88938d"
color-link identifier "bold #7ed8b7"
color-link constant "bold #abcebe"
color-link statement "bold #ffb4ab"
color-link symbol "bold #7ed8b7"
color-link preproc "bold #abcebe"
color-link type "bold #ffb4ab"
color-link special "bold #7ed8b7"
color-link underlined "underline #abcebe"
color-link error "bold #ffb4ab"
color-link todo "bold #003829,#7ed8b7"
color-link hlsearch "#16362b,#abcebe"
color-link statusline "#dfe4df,default"
color-link tabbar "#dfe4df,default"
color-link indent-char "#3e4944"
color-link line-number "#88938d,default"
color-link current-line-number "bold #7ed8b7,default"
color-link diff-added "bold #7ed8b7"
color-link diff-modified "bold #abcebe"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#ffb4ab"
color-link cursor-line "#3e4944"
color-link color-column "#3e4944"
