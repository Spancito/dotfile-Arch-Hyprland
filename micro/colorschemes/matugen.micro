color-link default "#dee4e2,default"
color-link comment "#869491"
color-link identifier "bold #59dacc"
color-link constant "bold #a2cfc8"
color-link statement "bold #ffb59a"
color-link symbol "bold #59dacc"
color-link preproc "bold #a2cfc8"
color-link type "bold #ffb59a"
color-link special "bold #59dacc"
color-link underlined "underline #a2cfc8"
color-link error "bold #ffb4ab"
color-link todo "bold #003732,#59dacc"
color-link hlsearch "#053732,#a2cfc8"
color-link statusline "#dee4e2,default"
color-link tabbar "#dee4e2,default"
color-link indent-char "#3c4947"
color-link line-number "#869491,default"
color-link current-line-number "bold #59dacc,default"
color-link diff-added "bold #59dacc"
color-link diff-modified "bold #a2cfc8"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#ffb59a"
color-link cursor-line "#3c4947"
color-link color-column "#3c4947"
