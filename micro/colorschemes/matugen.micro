color-link default "#e4e2e3,default"
color-link comment "#929092"
color-link identifier "bold #c0c7d5"
color-link constant "bold #c4c6cf"
color-link statement "bold #bdc7dc"
color-link symbol "bold #c0c7d5"
color-link preproc "bold #c4c6cf"
color-link type "bold #bdc7dc"
color-link special "bold #c0c7d5"
color-link underlined "underline #c4c6cf"
color-link error "bold #ffb4ab"
color-link todo "bold #2a313c,#c0c7d5"
color-link hlsearch "#2d3038,#c4c6cf"
color-link statusline "#e4e2e3,default"
color-link tabbar "#e4e2e3,default"
color-link indent-char "#474648"
color-link line-number "#929092,default"
color-link current-line-number "bold #c0c7d5,default"
color-link diff-added "bold #c0c7d5"
color-link diff-modified "bold #c4c6cf"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#bdc7dc"
color-link cursor-line "#474648"
color-link color-column "#474648"
