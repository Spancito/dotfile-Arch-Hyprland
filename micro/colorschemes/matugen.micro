color-link default "#eae1d9,default"
color-link comment "#9b8f81"
color-link identifier "bold #ffd79f"
color-link constant "bold #dbc3a4"
color-link statement "bold #cadeff"
color-link symbol "bold #ffd79f"
color-link preproc "bold #dbc3a4"
color-link type "bold #cadeff"
color-link special "bold #ffd79f"
color-link underlined "underline #dbc3a4"
color-link error "bold #ffb4ab"
color-link todo "bold #442c00,#ffd79f"
color-link hlsearch "#3d2e18,#dbc3a4"
color-link statusline "#eae1d9,default"
color-link tabbar "#eae1d9,default"
color-link indent-char "#4f4539"
color-link line-number "#9b8f81,default"
color-link current-line-number "bold #ffd79f,default"
color-link diff-added "bold #ffd79f"
color-link diff-modified "bold #dbc3a4"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#cadeff"
color-link cursor-line "#4f4539"
color-link color-column "#4f4539"
