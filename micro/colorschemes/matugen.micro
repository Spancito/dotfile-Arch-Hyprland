color-link default "#eedfde,default"
color-link comment "#a18c8a"
color-link identifier "bold #ffb3af"
color-link constant "bold #ebbbb8"
color-link statement "bold #8ad6b4"
color-link symbol "bold #ffb3af"
color-link preproc "bold #ebbbb8"
color-link type "bold #8ad6b4"
color-link special "bold #ffb3af"
color-link underlined "underline #ebbbb8"
color-link error "bold #ffb4ab"
color-link todo "bold #571d1d,#ffb3af"
color-link hlsearch "#472827,#ebbbb8"
color-link statusline "#eedfde,default"
color-link tabbar "#eedfde,default"
color-link indent-char "#534342"
color-link line-number "#a18c8a,default"
color-link current-line-number "bold #ffb3af,default"
color-link diff-added "bold #ffb3af"
color-link diff-modified "bold #ebbbb8"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#8ad6b4"
color-link cursor-line "#534342"
color-link color-column "#534342"
