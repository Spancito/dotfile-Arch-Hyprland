color-link default "#e9e1e0,default"
color-link comment "#9c8d8c"
color-link identifier "bold #e7bcb9"
color-link constant "bold #d8c1bf"
color-link statement "bold #b2ccc1"
color-link symbol "bold #e7bcb9"
color-link preproc "bold #d8c1bf"
color-link type "bold #b2ccc1"
color-link special "bold #e7bcb9"
color-link underlined "underline #d8c1bf"
color-link error "bold #ffb4ab"
color-link todo "bold #442927,#e7bcb9"
color-link hlsearch "#3b2d2c,#d8c1bf"
color-link statusline "#e9e1e0,default"
color-link tabbar "#e9e1e0,default"
color-link indent-char "#504443"
color-link line-number "#9c8d8c,default"
color-link current-line-number "bold #e7bcb9,default"
color-link diff-added "bold #e7bcb9"
color-link diff-modified "bold #d8c1bf"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#b2ccc1"
color-link cursor-line "#504443"
color-link color-column "#504443"
