color-link default "#ece0dc,default"
color-link comment "#9f8d86"
color-link identifier "bold #fcb797"
color-link constant "bold #e3bfaf"
color-link statement "bold #94d1d2"
color-link symbol "bold #fcb797"
color-link preproc "bold #e3bfaf"
color-link type "bold #94d1d2"
color-link special "bold #fcb797"
color-link underlined "underline #e3bfaf"
color-link error "bold #ffb4ab"
color-link todo "bold #4f250f,#fcb797"
color-link hlsearch "#422b20,#e3bfaf"
color-link statusline "#ece0dc,default"
color-link tabbar "#ece0dc,default"
color-link indent-char "#52443e"
color-link line-number "#9f8d86,default"
color-link current-line-number "bold #fcb797,default"
color-link diff-added "bold #fcb797"
color-link diff-modified "bold #e3bfaf"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#94d1d2"
color-link cursor-line "#52443e"
color-link color-column "#52443e"
