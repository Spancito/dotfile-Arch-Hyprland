color-link default "#e1e2e5,default"
color-link comment "#8b9298"
color-link identifier "bold #98cdf1"
color-link constant "bold #b5c9d9"
color-link statement "bold #f6bb79"
color-link symbol "bold #98cdf1"
color-link preproc "bold #b5c9d9"
color-link type "bold #f6bb79"
color-link special "bold #98cdf1"
color-link underlined "underline #b5c9d9"
color-link error "bold #ffb4ab"
color-link todo "bold #00344b,#98cdf1"
color-link hlsearch "#20333f,#b5c9d9"
color-link statusline "#e1e2e5,default"
color-link tabbar "#e1e2e5,default"
color-link indent-char "#41484d"
color-link line-number "#8b9298,default"
color-link current-line-number "bold #98cdf1,default"
color-link diff-added "bold #98cdf1"
color-link diff-modified "bold #b5c9d9"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#f6bb79"
color-link cursor-line "#41484d"
color-link color-column "#41484d"
