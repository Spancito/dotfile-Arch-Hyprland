color-link default "#fddada,default"
color-link comment "#ad8788"
color-link identifier "bold #ffb3b4"
color-link constant "bold #ffb3b4"
color-link statement "bold #73d7cc"
color-link symbol "bold #ffb3b4"
color-link preproc "bold #ffb3b4"
color-link type "bold #73d7cc"
color-link special "bold #ffb3b4"
color-link underlined "underline #ffb3b4"
color-link error "bold #ffb4ab"
color-link todo "bold #680017,#ffb3b4"
color-link hlsearch "#680017,#ffb3b4"
color-link statusline "#fddada,default"
color-link tabbar "#fddada,default"
color-link indent-char "#5d3f3f"
color-link line-number "#ad8788,default"
color-link current-line-number "bold #ffb3b4,default"
color-link diff-added "bold #ffb3b4"
color-link diff-modified "bold #ffb3b4"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#73d7cc"
color-link cursor-line "#5d3f3f"
color-link color-column "#5d3f3f"
