color-link default "#dfe3e6,default"
color-link comment "#889297"
color-link identifier "bold #b1e7ff"
color-link constant "bold #abccdb"
color-link statement "bold #ffd9b4"
color-link symbol "bold #b1e7ff"
color-link preproc "bold #abccdb"
color-link type "bold #ffd9b4"
color-link special "bold #b1e7ff"
color-link underlined "underline #abccdb"
color-link error "bold #ffb4ab"
color-link todo "bold #003544,#b1e7ff"
color-link hlsearch "#123440,#abccdb"
color-link statusline "#dfe3e6,default"
color-link tabbar "#dfe3e6,default"
color-link indent-char "#3e484d"
color-link line-number "#889297,default"
color-link current-line-number "bold #b1e7ff,default"
color-link diff-added "bold #b1e7ff"
color-link diff-modified "bold #abccdb"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#ffd9b4"
color-link cursor-line "#3e484d"
color-link color-column "#3e484d"
