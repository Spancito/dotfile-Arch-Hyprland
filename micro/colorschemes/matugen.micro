color-link default "#ece0d7,default"
color-link comment "#9e8e7f"
color-link identifier "bold #ffd4a9"
color-link constant "bold #e4c09c"
color-link statement "bold #bbe1ff"
color-link symbol "bold #ffd4a9"
color-link preproc "bold #e4c09c"
color-link type "bold #bbe1ff"
color-link special "bold #ffd4a9"
color-link underlined "underline #e4c09c"
color-link error "bold #ffb4ab"
color-link todo "bold #482900,#ffd4a9"
color-link hlsearch "#422c12,#e4c09c"
color-link statusline "#ece0d7,default"
color-link tabbar "#ece0d7,default"
color-link indent-char "#514538"
color-link line-number "#9e8e7f,default"
color-link current-line-number "bold #ffd4a9,default"
color-link diff-added "bold #ffd4a9"
color-link diff-modified "bold #e4c09c"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#bbe1ff"
color-link cursor-line "#514538"
color-link color-column "#514538"
