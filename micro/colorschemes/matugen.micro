color-link default "#e3e2e3,default"
color-link comment "#8c9195"
color-link identifier "bold #b0cbd7"
color-link constant "bold #bec8cd"
color-link statement "bold #e7bea2"
color-link symbol "bold #b0cbd7"
color-link preproc "bold #bec8cd"
color-link type "bold #e7bea2"
color-link special "bold #b0cbd7"
color-link underlined "underline #bec8cd"
color-link error "bold #ffb4ab"
color-link todo "bold #1a343d,#b0cbd7"
color-link hlsearch "#283236,#bec8cd"
color-link statusline "#e3e2e3,default"
color-link tabbar "#e3e2e3,default"
color-link indent-char "#42484a"
color-link line-number "#8c9195,default"
color-link current-line-number "bold #b0cbd7,default"
color-link diff-added "bold #b0cbd7"
color-link diff-modified "bold #bec8cd"
color-link diff-deleted "bold #ffb4ab"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e7bea2"
color-link cursor-line "#42484a"
color-link color-column "#42484a"
