{
    "margin-top": 10,
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a, %d. %b}"
    },
    "custom/media": {
        "format": "{}",
        "escape": false,
        "return-type": "json",
        "max-length": 35,
        "on-click": "python3 $HOME/.config/waybar/scripts/miniplayer.py",
        "on-click-right": "playerctl stop",
        "smooth-scrolling-threshold": 1,
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": false,
        "active-only": false,
        "on-click": "activate",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "HDMI-A-1": [
                1,
                2,
                3,
                4,
                5
            ],
            "DP-1": [
                6,
                7,
                8,
                9,
                10
            ]
        }
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{volume}%  {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%)  ",
        "format-ethernet": "󰊗  Ethernet",
        "format-disconnected": "",
        "tooltip-format": "{ifname} via {gwaddr}  󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) \nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname} \nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "python3 $HOME/.config/waybar/scripts/taskswidget.py"
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "show-passive-items": true
    },
    "layer": "bottom",
    "modules-left": [
        "custom/launcher",
        "clock",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/media"
    ],
    "modules-right": [
        "tray",
        "pulseaudio",
        "network"
    ]
}
