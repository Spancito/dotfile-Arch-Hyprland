* {
    primary: #ffb4ab;
    secondary: #ffb4ab;
    tertiary: #85cfff;
    error: #ffb4ab;

    surface: #1e100e;
    surface-container: #2c1c1a;
    surface-container-highest: #42302e;

    on-surface: #f9dcd8;
    on-surface-variant: #e4beb9;
    outline: #ab8985;

    bg0: #1e100e;
    bg0-transparent: #1e100eB3;
    bg1: #271816;
    bg2: #2c1c1a;
    bg2-transparent: #2c1c1aB3;
    bg3: #42302e;
    bg4: #473533;
    text: #f9dcd8;
    red: #ffb4ab;
    green: #85cfff;
    blue: #ffb4ab;
    grey1: #e4beb9;
}
