    bg0: #171210;
    bg0-transparent: #171210B3;
    bg1: #201a18;
    bg2: #241e1c;
    bg2-transparent: #241e1cB3;
    bg3: #3a3331;
    bg4: #3e3835;
    text: #ece0dc;
    red: #ffb4ab;
    green: #94d1d2;
    blue: #fcb797;
    grey1: #d7c2ba;
