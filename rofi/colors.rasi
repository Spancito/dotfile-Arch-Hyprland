    bg0: #121316;
    bg0-transparent: #121316B3;
    bg1: #1b1b1e;
    bg2: #1f2022;
    bg2-transparent: #1f2022B3;
    bg3: #343537;
    bg4: #38393c;
    text: #e3e2e5;
    red: #ffb4ab;
    green: #e4c286;
    blue: #b2c8ed;
    grey1: #c4c6ce;
