* {
    primary: #ffd79f;
    secondary: #dbc3a4;
    tertiary: #cadeff;
    error: #ffb4ab;

    surface: #16130f;
    surface-container: #231f1a;
    surface-container-highest: #38342f;

    on-surface: #eae1d9;
    on-surface-variant: #d2c4b5;
    outline: #9b8f81;

    bg0: #16130f;
    bg0-transparent: #16130fB3;
    bg1: #1f1b16;
    bg2: #231f1a;
    bg2-transparent: #231f1aB3;
    bg3: #38342f;
    bg4: #3d3833;
    text: #eae1d9;
    red: #ffb4ab;
    green: #cadeff;
    blue: #ffd79f;
    grey1: #d2c4b5;
}
