    bg0: #131318;
    bg0-transparent: #131318B3;
    bg1: #1b1b21;
    bg2: #201f25;
    bg2-transparent: #201f25B3;
    bg3: #35343a;
    bg4: #39383f;
    text: #e5e1e9;
    red: #ffb4ab;
    green: #eab9d1;
    blue: #c3c0ff;
    grey1: #c8c5d0;
