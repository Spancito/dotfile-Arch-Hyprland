    bg0: #131313;
    bg0-transparent: #131313B3;
    bg1: #1b1c1b;
    bg2: #1f2020;
    bg2-transparent: #1f2020B3;
    bg3: #343535;
    bg4: #393939;
    text: #e4e2e1;
    red: #ffb4ab;
    green: #ddc1b6;
    blue: #bacac9;
    grey1: #c2c7c7;
