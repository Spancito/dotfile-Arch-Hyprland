* {
    primary: #fdbc30;
    secondary: #e5c184;
    tertiary: #9ccbff;
    error: #ffb4ab;

    surface: #18130a;
    surface-container: #241f16;
    surface-container-highest: #3a342a;

    on-surface: #ede1d2;
    on-surface-variant: #d4c4ad;
    outline: #9d8f7a;

    bg0: #18130a;
    bg0-transparent: #18130aB3;
    bg1: #201b12;
    bg2: #241f16;
    bg2-transparent: #241f16B3;
    bg3: #3a342a;
    bg4: #3f382e;
    text: #ede1d2;
    red: #ffb4ab;
    green: #9ccbff;
    blue: #fdbc30;
    grey1: #d4c4ad;
}
