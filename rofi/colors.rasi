    primary: #59dacc;
    secondary: #a2cfc8;
    tertiary: #ffb59a;
    error: #ffb4ab;

    surface: #0e1514;
    surface-container: #1b2120;
    surface-container-highest: #303635;

    on-surface: #dee4e2;
    on-surface-variant: #bbc9c6;
    outline: #869491;

    bg0: #0e1514;
    bg0-transparent: #0e1514B3;
    bg1: #171d1c;
    bg2: #1b2120;
    bg2-transparent: #1b2120B3;
    bg3: #303635;
    bg4: #343a39;
    text: #dee4e2;
    red: #ffb4ab;
    green: #ffb59a;
    blue: #59dacc;
    grey1: #bbc9c6;
}
