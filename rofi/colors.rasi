    outline: #9c8d90;

    bg0: #161213;
    bg0-transparent: #161213B3;
    bg1: #1f1a1b;
    bg2: #231e1f;
    bg2-transparent: #231e1fB3;
    bg3: #393334;
    bg4: #3d3839;
    text: #eae0e1;
    red: #ffb4ab;
    green: #afcfaa;
    blue: #f0b7c8;
    grey1: #d4c2c6;
}
