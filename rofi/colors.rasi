    bg0: #131314;
    bg0-transparent: #131314B3;
    bg1: #1b1b1c;
    bg2: #1f2020;
    bg2-transparent: #1f2020B3;
    bg3: #353536;
    bg4: #39393a;
    text: #e4e2e3;
    red: #ffb4ab;
    green: #e1c0ac;
    blue: #bbc8d7;
    grey1: #c4c6cc;
