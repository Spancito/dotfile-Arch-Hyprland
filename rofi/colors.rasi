    bg0: #200f0f;
    bg0-transparent: #200f0fB3;
    bg1: #291717;
    bg2: #2d1b1b;
    bg2-transparent: #2d1b1bB3;
    bg3: #452f30;
    bg4: #4a3434;
    text: #fddada;
    red: #ffb4ab;
    green: #73d7cc;
    blue: #ffb3b4;
    grey1: #e7bcbc;
}
