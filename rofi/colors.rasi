    bg0-transparent: #131314B3;
    bg1: #1c1b1c;
    bg2: #201f20;
    bg2-transparent: #201f20B3;
    bg3: #353435;
    bg4: #3a3939;
    text: #e5e2e2;
    red: #ffb4ab;
    green: #d3c4bb;
    blue: #c4c6cd;
    grey1: #c6c6cb;
