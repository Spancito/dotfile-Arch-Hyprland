    error: #ffb4ab;

    surface: #121414;
    surface-container: #1f2020;
    surface-container-highest: #343536;

    on-surface: #e3e2e3;
    on-surface-variant: #c2c7ca;
    outline: #8c9195;

    bg0: #121414;
    bg0-transparent: #121414B3;
    bg1: #1a1c1c;
    bg2: #1f2020;
    bg2-transparent: #1f2020B3;
    bg3: #343536;
    bg4: #38393a;
    text: #e3e2e3;
    red: #ffb4ab;
    green: #e7bea2;
    blue: #b0cbd7;
    grey1: #c2c7ca;
}
