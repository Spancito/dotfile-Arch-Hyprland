    bg0: #171218;
    bg0-transparent: #171218B3;
    bg1: #201a20;
    bg2: #241e24;
    bg2-transparent: #241e24B3;
    bg3: #39333a;
    bg4: #3e373e;
    text: #ebdfe9;
    red: #ffb4ab;
    green: #c5ce52;
    blue: #efb0ff;
    grey1: #d2c2d1;
