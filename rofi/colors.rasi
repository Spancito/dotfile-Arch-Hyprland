    bg0: #181211;
    bg0-transparent: #181211B3;
    bg1: #211a19;
    bg2: #251e1d;
    bg2-transparent: #251e1dB3;
    bg3: #3b3332;
    bg4: #403737;
    text: #eedfde;
    red: #ffb4ab;
    green: #8ad6b4;
    blue: #ffb3af;
    grey1: #d9c1bf;
}
