    outline: #8d9194;

    bg0: #131314;
    bg0-transparent: #131314B3;
    bg1: #1b1c1c;
    bg2: #1f2020;
    bg2-transparent: #1f2020B3;
    bg3: #343535;
    bg4: #39393a;
    text: #e4e2e2;
    red: #ffb4ab;
    green: #ddc1ac;
    blue: #bac9d2;
    grey1: #c3c7ca;
