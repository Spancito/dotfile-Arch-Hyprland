* {
    primary: #e7bcb9;
    secondary: #d8c1bf;
    tertiary: #b2ccc1;
    error: #ffb4ab;

    surface: #161312;
    surface-container: #221f1e;
    surface-container-highest: #383433;

    on-surface: #e9e1e0;
    on-surface-variant: #d4c3c1;
    outline: #9c8d8c;

    bg0: #161312;
    bg0-transparent: #161312B3;
    bg1: #1e1b1a;
    bg2: #221f1e;
    bg2-transparent: #221f1eB3;
    bg3: #383433;
    bg4: #3c3838;
    text: #e9e1e0;
    red: #ffb4ab;
    green: #b2ccc1;
    blue: #e7bcb9;
    grey1: #d4c3c1;
}
