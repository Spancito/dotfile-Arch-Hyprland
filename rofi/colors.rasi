* {
    primary: #ffb4a3;
    secondary: #ffb4a3;
    tertiary: #aec6ff;
    error: #ffb4ab;

    surface: #1f0f0b;
    surface-container: #2d1b17;
    surface-container-highest: #44302b;

    on-surface: #fddbd4;
    on-surface-variant: #e7bdb4;
    outline: #ad8880;

    bg0: #1f0f0b;
    bg0-transparent: #1f0f0bB3;
    bg1: #291713;
    bg2: #2d1b17;
    bg2-transparent: #2d1b17B3;
    bg3: #44302b;
    bg4: #49342f;
    text: #fddbd4;
    red: #ffb4ab;
    green: #aec6ff;
    blue: #ffb4a3;
    grey1: #e7bdb4;
}
