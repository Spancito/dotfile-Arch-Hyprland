color-link default "{{colors.on_surface.default.hex}},default"
color-link comment "{{colors.outline.default.hex}}"
color-link identifier "bold {{colors.primary.default.hex}}"
color-link constant "bold {{colors.secondary.default.hex}}"
color-link statement "bold {{colors.tertiary.default.hex}}"
color-link symbol "bold {{colors.primary.default.hex}}"
color-link preproc "bold {{colors.secondary.default.hex}}"
color-link type "bold {{colors.tertiary.default.hex}}"
color-link special "bold {{colors.primary.default.hex}}"
color-link underlined "underline {{colors.secondary.default.hex}}"
color-link error "bold {{colors.error.default.hex}}"
color-link todo "bold {{colors.on_primary.default.hex}},{{colors.primary.default.hex}}"
color-link hlsearch "{{colors.on_secondary.default.hex}},{{colors.secondary.default.hex}}"
color-link statusline "{{colors.on_surface.default.hex}},default"
color-link tabbar "{{colors.on_surface.default.hex}},default"
color-link indent-char "{{colors.surface_variant.default.hex}}"
color-link line-number "{{colors.outline.default.hex}},default"
color-link current-line-number "bold {{colors.primary.default.hex}},default"
color-link diff-added "bold {{colors.primary.default.hex}}"
color-link diff-modified "bold {{colors.secondary.default.hex}}"
color-link diff-deleted "bold {{colors.error.default.hex}}"
color-link gutter-error "{{colors.error.default.hex}}"
color-link gutter-warning "{{colors.tertiary.default.hex}}"
color-link cursor-line "{{colors.surface_variant.default.hex}}"
color-link color-column "{{colors.surface_variant.default.hex}}"
