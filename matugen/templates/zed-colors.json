{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Matugen",
  "author": "Antigravity",
  "themes": [
    {
      "name": "Matugen",
      "appearance": "dark",
      "style": {
        "border": "{{colors.outline.default.hex}}",
        "border.variant": "{{colors.outline_variant.default.hex}}",
        "border.focused": "{{colors.primary.default.hex}}",
        "border.transparent": "#00000000",
        "background": "#00000000",
        "title_bar.background": "#00000000",
        "editor.background": "#00000000",
        "panel.background": "#00000000",
        "status_bar.background": "#00000000",
        "tab_bar.background": "#00000000",
        "tab.inactive_background": "#00000000",
        "tab.active_background": "{{colors.surface_container_low.default.hex}}60",
        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "element.background": "#00000000",
        "element.hover": "{{colors.surface_container_high.default.hex}}60",
        "element.active": "{{colors.surface_container_highest.default.hex}}60",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{colors.surface_container_high.default.hex}}60",
        "ghost_element.active": "{{colors.surface_container_highest.default.hex}}60",
        "scrollbar_thumb.background": "{{colors.outline_variant.default.hex}}80",
        "scrollbar.background": "#00000000",
        "syntax": {
          "keyword": { "color": "{{colors.primary.default.hex}}", "font_weight": 800 },
          "function": { "color": "{{colors.secondary.default.hex}}", "font_weight": 800 },
          "string": { "color": "{{colors.tertiary.default.hex}}", "font_weight": 800 },
          "type": { "color": "{{colors.primary.default.hex}}", "font_weight": 800 },
          "variable": { "color": "{{colors.on_surface.default.hex}}", "font_weight": 800 },
          "property": { "color": "{{colors.secondary.default.hex}}", "font_weight": 800 },
          "number": { "color": "{{colors.tertiary.default.hex}}", "font_weight": 800 },
          "comment": { "color": "{{colors.outline.default.hex}}" }
        }
      }
    }
  ]
}
